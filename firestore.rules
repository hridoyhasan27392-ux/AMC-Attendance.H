rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }
    function hasProfile() {
      return signedIn() &&
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid));
    }
    function isAdmin() { return hasProfile() && myProfile().role == 'admin'; }
    function isTeacher() { return hasProfile() && myProfile().role == 'teacher'; }
    function isStudent() { return hasProfile() && myProfile().role == 'student'; }

    match /profiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }
    match /students/{id} {
      allow read: if isAdmin() || isTeacher() ||
        (isStudent() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /courses/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }
    match /sessions/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin();
    }
    match /attendance/{id} {
      allow read: if isAdmin() || isTeacher() ||
        (isStudent() && (resource.data.studentUid == request.auth.uid));
      allow create: if isAdmin() || isTeacher();
      allow update, delete: if isAdmin();
    }
    match /notices/{id} {
      allow read: if hasProfile();
      allow create, update, delete: if isAdmin() || isTeacher();
    }
    match /marks/{id} {
      allow read: if isAdmin() || isTeacher() ||
        (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create, update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }
  }
}
